	)
	(text "J8 - Normal operation has a jumper fitted across pins 1-2.  Logic level can \nbe observed between 3-5.  To simulate LEAD-ON/OFF events, the students must move \nthe shunt to pins 3-4 and connect the AD3 across 5-6.  Inverted 9V version can \nbe observed at 7-8.  Amplifier output can be see between pins 9 and 10.\n"
		(exclude_from_sim no)
		(at 22.606 189.992 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "4f97873f-0514-4196-8d12-008b57340dbd")
	)
